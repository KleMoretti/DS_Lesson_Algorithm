<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20" prefWidth="400" prefHeight="350"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.indi.llk.Window_Controller.Settings_Controller">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox spacing="10">
        <Label text="Sound Settings" style="-fx-font-size: 16;"/>
        <CheckBox fx:id="bgmCheckBox" text="Background Music"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Volume:"/>
            <Slider fx:id="volumeSlider" min="0" max="1" value="0.5"
                    showTickLabels="true" showTickMarks="true"
                    majorTickUnit="0.25" blockIncrement="0.1"
                    prefWidth="200"/>
            <Label fx:id="volumeLabel" text="50%"/>
        </HBox>
        <CheckBox fx:id="sfxCheckBox" text="Sound Effects"/>

        <Separator>
            <VBox.margin>
                <Insets top="10" bottom="10"/>
            </VBox.margin>
        </Separator>

        <Label text="Difficulty" style="-fx-font-size: 16;"/>
        <ComboBox fx:id="difficultyComboBox" prefWidth="200"/>
    </VBox>

    <HBox alignment="CENTER" spacing="20">
        <Button fx:id="saveButton" text="Save" onAction="#saveSettings"/>
        <Button fx:id="cancelButton" text="Cancel" onAction="#closeWindow"/>
    </HBox>
</VBox>